# Public URL of the site (used for canonical links, sitemap and Open Graph).
# On Vercel this defaults to your production domain automatically.
NEXT_PUBLIC_SITE_URL=
# Link used for the "Source code" / GitHub icons.
NEXT_PUBLIC_REPO_URL=

# Optional: GitHub token (no permissions needed) for the repo size/metadata lookup.
# Without it, lookups share GitHub's 60 requests/hour limit per server IP.
GITHUB_TOKEN=

# Optional: Upstash Redis for a cache and rate limit shared across serverless instances.
# The Vercel Marketplace Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limits (defaults shown)
MAX_REPO_MB=400
MAX_PACK_MB=200
FETCH_TIMEOUT_SECONDS=120
CACHE_TTL_MINUTES=360
DIGS_PER_WINDOW=12
RATE_WINDOW_MINUTES=15
